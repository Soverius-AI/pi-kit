{
  "display_information": { "name": "pi-kit Rooms", "description": "Enter your pi-kit Rooms from Slack channels" },
  "features": { "bot_user": { "display_name": "pi-kit Rooms", "always_online": false } },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "chat:write",
        "files:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "event_subscriptions": { "bot_events": ["app_mention", "message.channels", "message.groups"] }
  }
}
