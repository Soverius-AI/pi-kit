{
  "name": "renderer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "pk",
  "sourceRoot": "apps/renderer/src",
  "tags": [
    "scope:app"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/renderer",
        "browser": "apps/renderer/src/main.ts",
        "tsConfig": "apps/renderer/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/renderer/public"
          },
          {
            "glob": "**/*",
            "input": "node_modules/katex/dist/fonts",
            "output": "assets/katex/fonts"
          },
          {
            "glob": "*.json",
            "input": "libs/shared/i18n/src/lib/translations",
            "output": "i18n"
          }
        ],
        "styles": [
          "apps/renderer/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "3.5mb",
              "maximumError": "4mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": false
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "renderer:build:production"
        },
        "development": {
          "buildTarget": "renderer:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "renderer:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "renderer:build",
        "staticFilePath": "dist/apps/renderer/browser",
        "spa": true
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "cache": true,
      "options": {
        "tsConfig": "apps/renderer/tsconfig.spec.json",
        "buildTarget": "renderer:build:development",
        "runner": "vitest",
        "include": [
          "apps/renderer/src/**/*.spec.ts"
        ],
        "setupFiles": [
          "apps/renderer/src/test-setup.ts"
        ]
      }
    }
  }
}
