{
  "name": "agents-feature-agents",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/agents/feature-agents/src",
  "projectType": "library",
  "prefix": "pk",
  "tags": [
    "scope:agents",
    "type:feature"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "tsConfig": "libs/agents/feature-agents/tsconfig.spec.json",
        "buildTarget": "renderer:build:development",
        "runner": "vitest",
        "include": [
          "libs/agents/feature-agents/src/**/*.spec.ts"
        ],
        "setupFiles": [
          "libs/agents/feature-agents/src/test-setup.ts"
        ]
      }
    }
  }
}
