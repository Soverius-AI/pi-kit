{
  "name": "chat-feature-chat",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/chat/feature-chat/src",
  "projectType": "library",
  "prefix": "pk",
  "tags": ["scope:chat", "type:feature"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "cache": true,
      "options": {
        "tsConfig": "libs/chat/feature-chat/tsconfig.spec.json",
        "buildTarget": "renderer:build:development",
        "runner": "vitest",
        "include": ["libs/chat/feature-chat/src/**/*.spec.ts"],
        "setupFiles": ["libs/chat/feature-chat/src/test-setup.ts"]
      }
    }
  }
}
