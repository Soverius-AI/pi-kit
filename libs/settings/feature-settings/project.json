{
  "name": "settings-feature-settings",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/settings/feature-settings/src",
  "projectType": "library",
  "prefix": "pk",
  "tags": [
    "scope:settings",
    "type:feature"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "cache": true,
      "options": {
        "tsConfig": "libs/settings/feature-settings/tsconfig.spec.json",
        "buildTarget": "renderer:build:development",
        "runner": "vitest",
        "include": [
          "libs/settings/feature-settings/src/**/*.spec.ts"
        ],
        "setupFiles": [
          "libs/settings/feature-settings/src/test-setup.ts"
        ]
      }
    }
  }
}
