{
  "name": "shared-design-system",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/design-system/src",
  "prefix": "pk",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:ui"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/shared/design-system/ng-package.json",
        "tsConfig": "libs/shared/design-system/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/shared/design-system/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "cache": true,
      "options": {
        "tsConfig": "libs/shared/design-system/tsconfig.spec.json",
        "buildTarget": "renderer:build:development",
        "runner": "vitest",
        "include": [
          "libs/shared/design-system/src/**/*.spec.ts"
        ],
        "setupFiles": [
          "libs/shared/design-system/src/test-setup.ts"
        ]
      }
    }
  }
}
