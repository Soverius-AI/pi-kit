diff --git a/src/common/zod-compat.js b/src/common/zod-compat.js
new file mode 100644
index 0000000..b4516e3
--- /dev/null
+++ b/src/common/zod-compat.js
@@ -0,0 +1,45 @@
+import { toJSONSchema } from 'zod';
+
+// Read-only Zod 4 definition view for the catalog's structural walkers. Keep
+// native definitions untouched: parsing, cloning and native conversion use them.
+const definitions = new WeakMap();
+export function zodDef(schema) {
+    if (!schema) return undefined;
+    const def = schema._zod?.def;
+    if (!def) return schema._def;
+    if (definitions.has(schema)) return definitions.get(schema);
+    const view = {
+        ...def,
+        typeName: `Zod${def.type[0].toUpperCase()}${def.type.slice(1)}`,
+        description: schema.description,
+    };
+    definitions.set(schema, view);
+    if (def.type === 'object') {
+        view.shape = () => schema.shape;
+        view.unknownKeys = def.catchall?._zod.def.type === 'never' ? 'strict'
+            : def.catchall ? 'passthrough' : 'strip';
+    }
+    if (def.type === 'array') view.type = def.element;
+    if (def.type === 'enum') view.values = Object.values(def.entries);
+    if (def.type === 'literal') view.value = def.values[0];
+    if (def.type === 'prefault') view.typeName = 'ZodDefault';
+    if (def.type === 'default' || def.type === 'prefault') view.defaultValue = () => def.defaultValue;
+    // Refinements live on the schema itself in Zod 4. Pipes replace effects;
+    // inspect the input, except preprocessors whose typed schema is the output.
+    if (def.type === 'pipe') {
+        view.typeName = def.in._zod.def.type === 'any' ? 'ZodPipeline' : 'ZodEffects';
+        view.schema = ['any', 'transform'].includes(def.in._zod.def.type) ? def.out : def.in;
+    }
+    return view;
+}
+
+// All runtime schema conversion goes through Zod 4, never the Zod 3 converter.
+export function zodToJsonSchema(schema, options = {}) {
+    return toJSONSchema(schema, {
+        target: options.target === 'openApi3' ? 'openapi-3.0' : 'draft-07',
+        io: 'input',
+        unrepresentable: 'any',
+        reused: 'inline',
+        override: options.override,
+    });
+}
diff --git a/src/common/zod-compat.test.js b/src/common/zod-compat.test.js
new file mode 100644
index 0000000..9d07943
--- /dev/null
+++ b/src/common/zod-compat.test.js
@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { z } from 'zod';
+import { zodDef, zodToJsonSchema } from './zod-compat.js';
+import { exclusiveUnion, exclusiveUnionOverride } from '../catalog/exclusive_union.js';
+import { spec, specDef, getSpecAnnotation } from '../catalog/spec_annotations.js';
+import { scrapeSchemaBehavior, DynamicStringSchema, ChildListSchema, ActionSchema,
+    FunctionCallSchema, DynamicValueSchema, MessageProcessor } from '../v0_9/index.js';
+import { basicCatalog } from '../v0_9/basic_catalog/index.js';
+
+test('Zod 4 structural views do not mutate native definitions', () => {
+    const item = z.string();
+    const schema = z.array(item);
+    assert.equal(zodDef(schema).type, item);
+    assert.equal(schema._zod.def.type, 'array');
+    assert.equal(zodDef(schema), zodDef(schema));
+    assert.deepEqual(zodToJsonSchema(schema).items, { type: 'string' });
+});
+
+test('legacy v0_9 exports bind nested, wrapped dynamic/action/child properties', () => {
+    const behavior = scrapeSchemaBehavior(z.object({
+        nested: z.array(z.object({ text: DynamicStringSchema.optional() })),
+        child: ChildListSchema.nullable(),
+        action: ActionSchema.default({ event: { name: 'save' } }),
+    }));
+    assert.equal(behavior.shape.nested.element.shape.text.type, 'DYNAMIC');
+    assert.equal(behavior.shape.child.type, 'STRUCTURAL');
+    assert.equal(behavior.shape.action.type, 'ACTION');
+    assert.equal(FunctionCallSchema.safeParse({ call: 'f', args: { literal: { key: true } } }).success, true);
+    assert.equal(DynamicValueSchema.safeParse({ path: '/x' }).success, true);
+});
+
+test('native conversion preserves exclusive oneOf and scalar checks', () => {
+    const schema = exclusiveUnion([z.string().min(2), z.number().min(1)]);
+    const json = zodToJsonSchema(schema, { override: exclusiveUnionOverride });
+    assert.deepEqual(json.oneOf, [{ type: 'string', minLength: 2 }, { type: 'number', minimum: 1 }]);
+    assert.equal(schema.safeParse('a').success, false);
+    assert.equal(schema.safeParse(3).success, true);
+});
+
+test('spec annotations clone via Zod 4 instance methods and preserve descriptions', () => {
+    const original = z.string().describe('original');
+    const annotated = spec(original, { keywords: { deprecated: true } });
+    assert.notEqual(annotated, original);
+    assert.equal(getSpecAnnotation(original), undefined);
+    assert.equal(annotated.description, 'original');
+    const named = specDef('Named', annotated).describe('renamed');
+    assert.equal(named.description, 'renamed');
+    assert.equal(getSpecAnnotation(named).defName, 'Named');
+});
+
+test('v0_9 basic catalog capabilities use native conversion successfully', () => {
+    const processor = new MessageProcessor([basicCatalog]);
+    assert.ok(processor.getClientCapabilities()['v0.9']);
+});
